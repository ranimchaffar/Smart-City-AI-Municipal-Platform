# ==============================================================================
# CONFIGURATION D'ENVIRONNEMENT — BILLETTERIE MUNICIPALE INTELLIGENTE (MEMBRE 5)
# ==============================================================================

# Port d'écoute du serveur backend Express
PORT=3001

# Chaîne de connexion PostgreSQL authentique (local ou conteneur)
# Format : postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/municipal_tickets

# Jeton d'authentification Bearer des agents municipaux (sécurité environnementale)
# Utilisé par le tableau de bord municipal pour arbitrer et modifier les statuts
STAFF_AUTH_TOKEN=municipal-staff-secret-2026

# Mode d'orchestration n8n :
# - 'mock' : Utilise le simulateur déterministe certifié de Membre 5 (aucun service externe requis)
# - 'live' : Appelle le véritable webhook HTTP n8n configuré par Membre 1
N8N_MODE=mock

# URL du webhook de production n8n (utilisé uniquement si N8N_MODE=live)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/municipal-ticket-v1

# Délai d'expiration de l'appel vers n8n en millisecondes
N8N_TIMEOUT_MS=15000

# Environnement d'exécution Node.js
NODE_ENV=development
